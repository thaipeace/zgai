# Mật khẩu đăng nhập web app (bắt buộc)
APP_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật >= 32 ký tự: ký cookie phiên và mã hóa cookie Zalo trong DB (bắt buộc)
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Gemini API key (https://aistudio.google.com/apikey).
# Lưu ý: gói Free có thể bị Google dùng dữ liệu để cải thiện sản phẩm — nên bật billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Database: để trống = file SQLite cục bộ ./data/zalo-ai.db (chỉ dùng khi chạy local).
# Trên Render Free BẮT BUỘC dùng Turso (ổ đĩa Render bị xóa mỗi lần deploy).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Múi giờ dùng để chia tin nhắn theo ngày
APP_TIMEZONE=Asia/Ho_Chi_Minh

PORT=3000

